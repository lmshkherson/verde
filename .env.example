# Скопіюйте у .env і заповніть.

# База даних. SQLite для розробки:
DATABASE_URL="file:./dev.db"
# Продакшен на Postgres — замініть рядок нижче і provider у prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Секрет для підпису сесії адмінки. Згенерувати: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Перший адміністратор, створюється командою npm run db:seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
